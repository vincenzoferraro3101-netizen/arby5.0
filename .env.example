# Copia questo file in .env (nella stessa cartella di server.py, su VPS /root/sniper/.env)
# e inserisci i valori reali. Il file .env NON va committato.

# Password del pannello admin (/admin)
ARBEXA_ADMIN_PW=

# Password per generare/rinnovare licenze
ARBEXA_LICENSE_PW=

# Password del gestionale (/gestionale)
ARBEXA_GESTIONALE_PW=

# Chiave di firma delle licenze.
# ATTENZIONE: usa la chiave già in uso in produzione, altrimenti
# tutte le licenze già emesse diventano non valide.
ARBEXA_LKEY=

# Token del bot Telegram (da @BotFather). Rigenera quello vecchio: era nel codice.
TELEGRAM_BOT_TOKEN=

# Facoltativo: chiave di sessione Flask. Se vuoto viene generata ad ogni avvio.
ARBEXA_SECRET=
